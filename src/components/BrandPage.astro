---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import ContactSection from "./ContactSection.astro";
import Footer from "./Footer.astro";
import brands from "../data/brands.json";
import { getLangFromUrl, useTranslations, withBase } from "../i18n/utils";

type Brand = (typeof brands)[number] & {
    image?: string;
    urlCatalog2?: string | null;
    catalog1name?: string;
    catalog2name?: string;
};

const { brandData } = Astro.props as { brandData: Brand };
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const en = lang === "en";
const base = withBase(en ? "/en" : "");

const getLogoPath = (path: string) => withBase(path.replace("../assets/", "/assets/"));

const title = `${brandData.brand} | Comercial Sapau`;
const description = en ? brandData.description_en : brandData.description_es;
const category = en ? brandData.category_en : brandData.category_es;

const catalogs = [
    { name: brandData.catalog1name || t("brand.catalog"), url: brandData.urlCatalog && withBase(brandData.urlCatalog) },
    { name: brandData.catalog2name, url: brandData.urlCatalog2 && withBase(brandData.urlCatalog2) },
].filter((c): c is { name: string; url: string } => Boolean(c.url && c.name));

// Same-area brands first, then the rest
const others = [
    ...brands.filter((b) => b.slug !== brandData.slug && b.area === brandData.area),
    ...brands.filter((b) => b.slug !== brandData.slug && b.area !== brandData.area),
].slice(0, 4);

const downloadIcon = "M12 4v11M7 10l5 5 5-5M5 20h14";
const externalIcon = "M7 17L17 7M8 7h9v9";
---

<Layout title={title} description={description}>
    <Header />

    <main>
        <!-- Brand hero -->
        <section class="mx-auto max-w-7xl px-5 pt-8 pb-20 md:px-8 md:pt-10 md:pb-24">
            <nav aria-label={t("brand.breadcrumb")} class="mb-8 flex flex-wrap items-center gap-2 text-sm text-muted md:mb-10">
                <a href={`${base}/`} class="py-2.5 hover:text-ink">{t("nav.inicio")}</a>
                <span aria-hidden="true">/</span>
                <a href={`${base}/#marcas`} class="py-2.5 hover:text-ink">{t("nav.marcas")}</a>
                <span aria-hidden="true">/</span>
                <span class="font-semibold text-ink" aria-current="page">{brandData.brand}</span>
            </nav>

            <div class="flex flex-wrap items-stretch gap-12 md:gap-14">
                <div class="flex flex-[1_1_460px] flex-col justify-center gap-7">
                    <div class="flex flex-wrap gap-2">
                        <span class="rounded-full border border-line bg-white px-3.5 py-2 text-[13px] font-semibold">{category}</span>
                        <span class="rounded-full border border-line bg-white px-3.5 py-2 text-[13px] font-semibold">{t("brand.official")}</span>
                    </div>
                    <h1 class="text-[clamp(64px,10vw,152px)] leading-[0.88] font-extrabold tracking-[-0.05em] break-words">
                        {brandData.brand}
                    </h1>
                    <p class="max-w-xl text-lg leading-relaxed text-[#3e4350] md:text-xl">{description}</p>
                    <div class="flex flex-wrap gap-3 pt-1">
                        {
                            catalogs.length > 0 && (
                                <a href="#catalogos" class="btn-dark">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={downloadIcon} /></svg>
                                    {catalogs.length > 1 ? t("brand.catalogsEyebrow") : t("brand.catalog")}
                                </a>
                            )
                        }
                        {
                            brandData.urlWeb && (
                                <a href={brandData.urlWeb} target="_blank" rel="noopener" class="btn-outline border-[#cdd2d8] text-ink hover:border-ink">
                                    {new URL(brandData.urlWeb).hostname.replace(/^www\./, "")}
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={externalIcon} /></svg>
                                </a>
                            )
                        }
                    </div>
                </div>

                <div class="relative flex min-h-[360px] flex-[1_1_460px] items-center justify-center overflow-hidden rounded-[32px] bg-white md:min-h-[520px]">
                    {
                        brandData.image ? (
                            <img src={withBase(brandData.image)} alt={brandData.brand} class="absolute inset-0 h-full w-full object-cover" />
                        ) : (
                            <img src={getLogoPath(brandData.logo)} alt={`Logo ${brandData.brand}`} class="max-h-[45%] max-w-[65%] object-contain" />
                        )
                    }
                </div>
            </div>
        </section>

        <!-- Catalogs -->
        {
            catalogs.length > 0 && (
                <section id="catalogos" class="scroll-mt-24 bg-white">
                    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-24">
                        <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
                            <div class="flex flex-col gap-3.5">
                                <div class="eyebrow">{t("brand.catalogsEyebrow")}</div>
                                <h2 class="text-[clamp(32px,3.6vw,48px)] leading-none font-bold">{t("brand.catalogsTitle")}</h2>
                            </div>
                            <p class="max-w-sm leading-relaxed text-muted">{t("brand.catalogsDesc")}</p>
                        </div>
                        <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-4">
                            {catalogs.map((catalog, i) => (
                                <a
                                    href={catalog.url}
                                    target="_blank"
                                    rel="noopener"
                                    class="group flex items-center gap-5 rounded-[22px] bg-ground p-6 transition-colors hover:bg-[#e8ebee]"
                                >
                                    <span
                                        class:list={[
                                            "flex h-[108px] w-[84px] shrink-0 flex-col justify-between rounded-[10px] p-3 font-display font-bold",
                                            i === 0 ? "bg-ink text-lime" : "bg-ocean text-white",
                                        ]}
                                    >
                                        <span class="text-base leading-tight break-words">{brandData.brand}</span>
                                        <span class="text-xs text-white/70">PDF</span>
                                    </span>
                                    <span class="flex flex-1 flex-col gap-1.5">
                                        <span class="font-display text-2xl font-bold tracking-tight">{catalog.name}</span>
                                        <span class="text-sm text-muted">PDF · {t("brand.download")}</span>
                                    </span>
                                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white transition-colors group-hover:bg-lime">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={downloadIcon} /></svg>
                                    </span>
                                </a>
                            ))}
                        </div>
                    </div>
                </section>
            )
        }

        <!-- Social -->
        {
            (brandData.youtubeChannelId || brandData.instagramHandle) && (
                <section class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-24">
                    <div class="mb-9 flex flex-wrap items-end justify-between gap-5">
                        <div class="flex flex-col gap-3.5">
                            <div class="eyebrow">{t("brand.videosEyebrow")}</div>
                            <h2 class="text-[clamp(32px,3.6vw,48px)] leading-none font-bold">
                                {t("brand.videosTitle")} {brandData.brand}.
                            </h2>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            {brandData.youtubeChannelId && (
                                <a
                                    href={`https://www.youtube.com/${brandData.youtubeHandle || "channel/" + brandData.youtubeChannelId}`}
                                    target="_blank"
                                    rel="noopener"
                                    class="btn-outline border-[#cdd2d8] py-3 text-[15px] text-ink hover:border-ink"
                                >
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="4" /><path d="M10 9.5v5l4.5-2.5z" /></svg>
                                    {brandData.youtubeHandle || "YouTube"}
                                </a>
                            )}
                            {brandData.instagramHandle && (
                                <a
                                    href={`https://www.instagram.com/${brandData.instagramHandle}`}
                                    target="_blank"
                                    rel="noopener"
                                    class="btn-outline border-[#cdd2d8] py-3 text-[15px] text-ink hover:border-ink"
                                >
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.8" /></svg>
                                    @{brandData.instagramHandle}
                                </a>
                            )}
                        </div>
                    </div>
                    {brandData.youtubeChannelId && (
                        <div class="aspect-video overflow-hidden rounded-[28px] bg-ink">
                            <iframe
                                src={`https://www.youtube.com/embed/videoseries?list=${brandData.youtubeChannelId.replace(/^UC/, "UU")}`}
                                title={`YouTube · ${brandData.brand}`}
                                loading="lazy"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen
                                class="h-full w-full border-0"
                            />
                        </div>
                    )}
                </section>
            )
        }

        <ContactSection
            brand={brandData.brand}
            title={t("brand.ctaTitle").replace("{brand}", brandData.brand)}
            description={t("brand.ctaDesc")}
        />

        <!-- Other brands -->
        <section class="bg-white">
            <div class="mx-auto max-w-7xl px-5 py-20 md:px-8">
                <div class="mb-7 flex flex-wrap items-center justify-between gap-5">
                    <h2 class="text-[32px] font-bold">{t("brand.others")}</h2>
                    <a href={`${base}/#marcas`} class="py-3 font-semibold text-ocean hover:text-ink">{t("brand.allBrands")}</a>
                </div>
                <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4">
                    {
                        others.map((b) => (
                            <a href={`${base}/brands/${b.slug}`} class="flex flex-col gap-7 rounded-[20px] bg-ground p-6 transition-colors hover:bg-[#e8ebee]">
                                <span class="text-xs font-semibold tracking-[0.14em] text-ocean uppercase">{en ? b.category_en : b.category_es}</span>
                                <span class="font-display text-[28px] font-bold tracking-tight">{b.brand}</span>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
