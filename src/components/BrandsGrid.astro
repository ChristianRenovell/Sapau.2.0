---
import brands from "../data/brands.json";
import { getLangFromUrl, useTranslations, withBase } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = withBase(lang === "en" ? "/en" : "");

const filters = [
    { id: "all", label: t("brands.all") },
    { id: "piscinas", label: lang === "en" ? "Pools" : "Piscinas" },
    { id: "jardin", label: lang === "en" ? "Garden" : "Jardín" },
    { id: "tiempo-libre", label: lang === "en" ? "Leisure" : "Tiempo libre" },
];
---

<section id="marcas" class="mx-auto max-w-7xl scroll-mt-20 px-5 py-24 md:px-8 md:pb-32">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <div class="flex flex-col gap-4">
            <div class="eyebrow">{t("brands.eyebrow")}</div>
            <h2 class="text-[clamp(36px,4.4vw,60px)] leading-none font-bold">{t("brands.title")}</h2>
        </div>
        <div role="group" aria-label={t("brands.filter")} class="flex flex-wrap gap-2">
            {
                filters.map((f, i) => (
                    <button
                        type="button"
                        data-filter={f.id}
                        aria-pressed={i === 0 ? "true" : "false"}
                        class="rounded-full border-[1.5px] border-[#cdd2d8] px-5 py-3 text-[15px] font-medium text-ink transition-colors hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:font-semibold aria-pressed:text-white"
                    >
                        {f.label}
                    </button>
                ))
            }
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-4">
        {
            brands.map((brand, i) => (
                <a
                    href={`${base}/brands/${brand.slug}`}
                    data-area={brand.area}
                    class="group flex min-h-[210px] flex-col justify-between gap-6 rounded-[22px] border border-line bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-ink hover:shadow-xl"
                >
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-xs font-semibold tracking-[0.14em] text-ocean uppercase">
                            {lang === "en" ? brand.category_en : brand.category_es}
                        </span>
                        <span class="text-[13px] text-muted tabular-nums">{String(i + 1).padStart(2, "0")}</span>
                    </div>
                    <div class="font-display text-[34px] leading-none font-bold tracking-tight">{brand.brand}</div>
                    <div class="flex items-center justify-between border-t border-[#eef0f2] pt-4">
                        <span class="text-[15px] font-semibold">{t("brands.view")}</span>
                        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-ground transition-colors group-hover:bg-lime">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
                        </span>
                    </div>
                </a>
            ))
        }
        <a
            href={`${base}/#contacto`}
            class="flex min-h-[210px] flex-col justify-between gap-6 rounded-[22px] bg-ink p-6 text-white transition-colors hover:bg-ocean"
        >
            <span class="text-xs font-semibold tracking-[0.14em] text-lime uppercase">{t("brands.proEyebrow")}</span>
            <div class="font-display text-[26px] leading-tight font-bold tracking-tight">{t("brands.proTitle")}</div>
            <span class="inline-flex items-center gap-2 text-[15px] font-semibold text-lime">
                {t("brands.proCta")}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </span>
        </a>
    </div>
</section>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("#marcas [data-filter]");
    const cards = document.querySelectorAll<HTMLElement>("#marcas [data-area]");

    buttons.forEach((button) => {
        button.addEventListener("click", () => {
            const filter = button.dataset.filter;
            buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
            cards.forEach((card) => {
                card.hidden = filter !== "all" && card.dataset.area !== filter;
            });
        });
    });

    // Area cards on the home page jump to the grid already filtered
    document.querySelectorAll<HTMLElement>("[data-area-link]").forEach((link) => {
        link.addEventListener("click", () => {
            const target = [...buttons].find((b) => b.dataset.filter === link.dataset.areaLink);
            target?.click();
        });
    });
</script>
