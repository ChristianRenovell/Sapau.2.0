---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
    /** "overlay": transparent over the hero until the page scrolls. */
    variant?: "overlay" | "solid";
}

const { variant = "solid" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = lang === "en" ? "/en" : "";

// Path of the same page in the other language
const path = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";
const esHref = path;
const enHref = path === "/" ? "/en" : `/en${path}`;

const navItems = [
    { name: t("nav.inicio"), href: `${base}/` },
    { name: t("nav.nosotros"), href: `${base}/#nosotros` },
    { name: t("nav.marcas"), href: `${base}/#marcas` },
    { name: t("nav.contacto"), href: `${base}/#contacto` },
];
---

<header
    id="header"
    data-variant={variant}
    class:list={[
        "top-0 left-0 z-50 w-full transition-colors duration-300",
        variant === "overlay" ? "fixed" : "sticky bg-ink",
    ]}
>
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-4 md:px-8 md:py-5">
        <a href={base || "/"} class="shrink-0">
            <img
                src="/assets/img/logos/sapauLogo2.png"
                alt="Comercial SAPAU"
                class="h-9 w-auto md:h-11"
            />
        </a>

        <nav aria-label="Principal" class="hidden items-center gap-1 lg:flex">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        class="px-3.5 py-3 text-[15px] font-medium text-white/80 transition-colors hover:text-white"
                    >
                        {item.name}
                    </a>
                ))
            }
            <span class="mx-2 h-5 w-px bg-white/25"></span>
            <a
                href={esHref}
                aria-label="Español"
                class:list={[
                    "px-1.5 py-3 text-[13px] font-semibold tracking-widest",
                    lang === "es" ? "text-white" : "text-white/55 hover:text-white",
                ]}>ES</a
            >
            <a
                href={enHref}
                aria-label="English"
                class:list={[
                    "px-1.5 py-3 text-[13px] font-semibold tracking-widest",
                    lang === "en" ? "text-white" : "text-white/55 hover:text-white",
                ]}>EN</a
            >
            <a href={`${base}/#contacto`} class="ml-3 rounded-full bg-lime px-5 py-3 text-[15px] font-semibold text-ink transition-colors hover:bg-white">
                {t("nav.cta")}
            </a>
        </nav>

        <button
            id="mobile-toggle"
            type="button"
            aria-label={t("nav.menu")}
            aria-expanded="false"
            aria-controls="mobile-dropdown"
            class="flex h-11 w-11 items-center justify-center rounded-full text-white lg:hidden"
        >
            <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h10"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-dropdown" class="hidden border-t border-white/10 bg-ink lg:hidden">
        <nav aria-label="Principal" class="flex flex-col gap-1 px-5 py-6">
            {
                navItems.map((item) => (
                    <a href={item.href} class="mobile-link py-3 font-display text-2xl font-bold text-white">
                        {item.name}
                    </a>
                ))
            }
            <div class="mt-5 flex items-center gap-3 border-t border-white/10 pt-6">
                <a
                    href={esHref}
                    class:list={[
                        "rounded-full px-4 py-2.5 text-sm font-semibold",
                        lang === "es" ? "bg-lime text-ink" : "border border-white/25 text-white",
                    ]}>ES</a
                >
                <a
                    href={enHref}
                    class:list={[
                        "rounded-full px-4 py-2.5 text-sm font-semibold",
                        lang === "en" ? "bg-lime text-ink" : "border border-white/25 text-white",
                    ]}>EN</a
                >
            </div>
        </nav>
    </div>
</header>

<script>
    const header = document.getElementById("header");
    const mobileToggle = document.getElementById("mobile-toggle");
    const mobileDropdown = document.getElementById("mobile-dropdown");
    const menuIcon = document.getElementById("menu-icon");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    const MENU_PATH = '<path d="M4 7h16M4 12h16M4 17h10"></path>';
    const CLOSE_PATH = '<path d="M6 18L18 6M6 6l12 12"></path>';

    let isOpen = false;

    // Overlay header gets a solid background once the page scrolls or the menu opens
    const updateBackground = () => {
        if (header?.dataset.variant !== "overlay") return;
        header.classList.toggle("bg-ink", isOpen || window.scrollY > 40);
    };

    const toggleMenu = () => {
        isOpen = !isOpen;
        mobileDropdown?.classList.toggle("hidden", !isOpen);
        mobileToggle?.setAttribute("aria-expanded", String(isOpen));
        menuIcon!.innerHTML = isOpen ? CLOSE_PATH : MENU_PATH;
        updateBackground();
    };

    window.addEventListener("scroll", updateBackground, { passive: true });
    updateBackground();

    mobileToggle?.addEventListener("click", toggleMenu);
    mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
            if (isOpen) toggleMenu();
        });
    });
</script>
