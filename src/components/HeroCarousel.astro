---
import { getLangFromUrl, useTranslations, withBase } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = withBase(lang === "en" ? "/en" : "");

const slides = [
    {
        title: "Campingaz",
        description: lang === "en" ? "Leader in BBQs and camping. Innovation in every outdoor outing." : "Líder en barbacoas y camping. Innovación en cada salida al aire libre.",
        image: "/assets/img/slide/Slide1.webp",
        alt: lang === "en" ? "Campingaz gas barbecue on a garden deck" : "Barbacoa de gas Campingaz en una terraza de jardín",
        link: `${base}/brands/campingaz`,
    },
    {
        title: "Gre",
        description: lang === "en" ? "Leader in above-ground pools, cleaners, covers and water treatment." : "Líder en piscinas desmontables, limpiafondos, cubiertas y tratamiento del agua.",
        image: "/assets/img/gre-mariposa.png",
        alt: lang === "en" ? "Gre pool with sun loungers on a rooftop" : "Piscina Gre con tumbonas en una azotea",
        link: `${base}/brands/gre`,
    },
    {
        title: "Coleman",
        description: lang === "en" ? "Passion for the outdoors: from coolers to tents for your next trip." : "Pasión por el outdoor: desde neveras hasta tiendas para tu próxima salida.",
        image: "/assets/img/slide/Slide3.webp",
        alt: lang === "en" ? "Two people on the beach with Coleman chairs and cooler" : "Dos personas en la playa con sillas y nevera Coleman",
        link: `${base}/brands/coleman`,
    },
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="inicio" class="hero relative flex min-h-[100svh] flex-col overflow-hidden bg-ink md:min-h-[780px]">
    {
        slides.map((slide, i) => (
            <img
                src={withBase(slide.image)}
                alt={slide.alt}
                data-hero-bg
                loading={i === 0 ? "eager" : "lazy"}
                class:list={[
                    "absolute inset-0 h-full w-full object-cover object-[60%_40%] transition-opacity duration-1000",
                    i === 0 ? "opacity-100" : "opacity-0",
                ]}
            />
        ))
    }
    <div class="absolute inset-0 bg-gradient-to-r from-ink/90 via-ink/60 to-ink/20"></div>

    <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-1 flex-wrap items-end justify-between gap-12 px-5 pt-36 pb-12 md:px-8 md:pb-14">
        <div class="flex max-w-3xl flex-[1_1_560px] flex-col gap-7">
            <div class="flex items-center gap-3 text-[13px] font-semibold tracking-[0.18em] text-lime uppercase">
                <span class="h-0.5 w-7 bg-lime"></span>
                <span>{t("hero.eyebrow")}</span>
            </div>
            <h1 class="text-[clamp(48px,7vw,104px)] leading-[0.95] font-extrabold tracking-[-0.035em] text-white">
                {t("hero.title")}
            </h1>
            <p class="max-w-xl text-lg leading-relaxed text-white/85 md:text-[19px]">
                {t("hero.description")}
            </p>
            <div class="flex flex-wrap gap-3 pt-2">
                <a href={`${base}/#marcas`} class="btn-primary">
                    {t("hero.btnBrands")}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </a>
                <a href={`${base}/#contacto`} class="btn-outline border-white/50 text-white hover:border-white">
                    {t("hero.btnCatalog")}
                </a>
            </div>
        </div>

        <!-- Featured brand card -->
        <div class="flex w-full max-w-[360px] flex-[0_1_340px] flex-col gap-5 rounded-3xl bg-white p-6 shadow-2xl shadow-black/25" aria-roledescription="carousel" aria-label={t("hero.featured")}>
            <div class="flex items-center justify-between text-xs font-semibold tracking-[0.14em] text-muted uppercase">
                <span>{t("hero.featured")}</span>
                <span class="tabular-nums"><span data-hero-count>01</span> / {pad(slides.length)}</span>
            </div>
            {
                slides.map((slide, i) => (
                    <div data-hero-slide class:list={["flex flex-col gap-1.5", i !== 0 && "hidden"]} aria-live="polite">
                        <div class="font-display text-[30px] font-bold tracking-tight">{slide.title}</div>
                        <p class="text-[15px] leading-normal text-muted">{slide.description}</p>
                        <a href={slide.link} class="inline-flex items-center gap-2 self-start py-3 text-[15px] font-semibold text-ocean hover:text-ink">
                            {t("brands.view")}
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
                        </a>
                    </div>
                ))
            }
            <div class="flex items-center justify-between gap-4">
                <div class="flex flex-1 gap-1.5">
                    {slides.map((_, i) => <span data-hero-bar class:list={["h-1 flex-1 rounded-full", i === 0 ? "bg-ink" : "bg-line"]} />)}
                </div>
                <div class="flex gap-2">
                    <button type="button" data-hero-prev aria-label={t("hero.prev")} class="flex h-11 w-11 items-center justify-center rounded-full border-[1.5px] border-line bg-white text-ink transition-colors hover:border-ink">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
                    </button>
                    <button type="button" data-hero-next aria-label={t("hero.next")} class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-white transition-colors hover:bg-ocean">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const hero = document.querySelector(".hero");
    const bgs = hero?.querySelectorAll<HTMLElement>("[data-hero-bg]") ?? [];
    const cards = hero?.querySelectorAll<HTMLElement>("[data-hero-slide]") ?? [];
    const bars = hero?.querySelectorAll<HTMLElement>("[data-hero-bar]") ?? [];
    const count = hero?.querySelector("[data-hero-count]");
    const total = cards.length;
    let current = 0;
    let timer: number | undefined;

    const show = (index: number) => {
        current = (index + total) % total;
        bgs.forEach((bg, i) => {
            bg.classList.toggle("opacity-100", i === current);
            bg.classList.toggle("opacity-0", i !== current);
        });
        cards.forEach((card, i) => card.classList.toggle("hidden", i !== current));
        bars.forEach((bar, i) => {
            bar.classList.toggle("bg-ink", i === current);
            bar.classList.toggle("bg-line", i !== current);
        });
        if (count) count.textContent = String(current + 1).padStart(2, "0");
    };

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const restart = () => {
        if (reducedMotion) return;
        window.clearInterval(timer);
        timer = window.setInterval(() => show(current + 1), 6000);
    };

    hero?.querySelector("[data-hero-prev]")?.addEventListener("click", () => {
        show(current - 1);
        restart();
    });
    hero?.querySelector("[data-hero-next]")?.addEventListener("click", () => {
        show(current + 1);
        restart();
    });
    restart();
</script>
