---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const slides = [
    {
        title: "Campingaz",
        subtitle: lang === 'en' ? "Leader in BBQs and Camping" : "Líder en Barbacoas y Camping",
        description: lang === 'en' ? "Discover innovation in every outdoor outing with products designed to last." : "Descubre la innovación en cada salida al aire libre con productos diseñados para durar.",
        image: "/assets/img/slide/Slide1.webp",
        btnText: t('brands.view'),
        btnLink: "/brands/campingaz"
    },
    {
        title: "Gre",
        subtitle: lang === 'en' ? "Leader in above-ground pools" : "Líder en piscinas desmontables",
        description: lang === 'en' ? "Above-ground pools, pool cleaners, pool covers, water treatment products, and everything you need for your pool." : "Piscinas elevadas, robots de limpieza, cubiertas para piscinas, productos para el tratamiento del agua y todo lo que necesitas para tu piscina.",
        image: "/assets/img/slide/gre.webp",
        btnText: t('brands.view'),
        btnLink: "/brands/gre"
    },
    {
        title: "Coleman",
        subtitle: lang === 'en' ? "Passion for the Outdoors" : "Pasión por el Outdoor",
        description: lang === 'en' ? "From coolers to tents, everything you need for your next expedition." : "Desde neveras hasta tiendas de campaña, todo lo necesario para tu próxima expedición.",
        image: "/assets/img/slide/Slide3.webp",
        btnText: t('brands.view'),
        btnLink: "/brands/coleman"
    }
];
---

<div class="relative w-full h-[85vh] overflow-hidden bg-[#f6f6f6]">
    <div class="swiper hero-swiper h-full">
        <div class="swiper-wrapper">
            {slides.map((slide) => (
                <div class="swiper-slide relative flex items-center justify-center">
                    <!-- Background Image with Overlay -->
                    <div class="absolute inset-0 z-0">
                        <img src={slide.image} class="w-full h-full object-cover opacity-20 object-center" alt={slide.title} />
                        <div class="absolute inset-0 bg-gradient-to-r from-[#f6f6f6] via-[#f6f6f6]/60 to-transparent"></div>
                    </div>
                    
                    <!-- Content -->
                    <div class="container mx-auto px-4 relative z-10 grid grid-cols-1 lg:grid-cols-2 lg:items-center h-full pt-20 lg:pt-0">
                        <!-- Image on top for mobile, right for desktop -->
                        <div class="order-1 lg:order-2 flex justify-center lg:pl-12">
                             <div class="relative w-[280px] h-[280px] md:w-[400px] md:h-[400px] lg:w-[580px] lg:h-[580px] rounded-full overflow-hidden border-[4px] md:border-[6px] lg:border-[8px] border-white shadow-2xl slide-img-container opacity-0">
                                <img src={slide.image} class="w-full h-full object-cover scale-110" alt={slide.title} />
                             </div>
                        </div>

                        <!-- Text content -->
                        <div class="slide-content text-center lg:text-left pt-8 lg:pt-0 order-2 lg:order-1">
                            <span class="slide-subtitle text-[#e2e63d] font-bold uppercase tracking-[0.3em] text-xs md:text-sm block mb-4 opacity-0">
                                {slide.subtitle}
                            </span>
                            <h2 class="slide-title text-4xl md:text-6xl lg:text-8xl font-bold text-[#222222] mb-6 lg:mb-8 leading-tight font-['Playfair_Display'] opacity-0">
                                {slide.title}
                            </h2>
                            <p class="slide-description text-sm md:text-lg lg:text-xl text-[#666666] max-w-lg mx-auto lg:mx-0 mb-8 lg:mb-12 leading-relaxed opacity-0">
                                {slide.description}
                            </p>
                            <div class="slide-button opacity-0">
                                <a href={slide.btnLink} class="obrien-btn">
                                    {slide.btnText}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
        
        <!-- Navigation Buttons -->
        <div class="swiper-button-next !text-[#222222] !w-12 !h-12 !bg-white/70 backdrop-blur rounded-full !after:text-lg hover:!bg-[#e2e63d] transition-all shadow-md"></div>
        <div class="swiper-button-prev !text-[#222222] !w-12 !h-12 !bg-white/70 backdrop-blur rounded-full !after:text-lg hover:!bg-[#e2e63d] transition-all shadow-md"></div>
        
        <!-- Pagination -->
        <div class="swiper-pagination !bottom-10"></div>
    </div>
</div>

<style>
    @reference "tailwindcss";

    :global(.swiper-pagination-bullet) {
        @apply !w-3 !h-3 !bg-[#222222] !opacity-20;
    }
    :global(.swiper-pagination-bullet-active) {
        @apply !w-10 !bg-[#e2e63d] !opacity-100 !rounded-full !transition-all !duration-300;
    }

    /* Animation Classes */
    .slide-active .slide-subtitle {
        animation: fadeInUp 0.8s ease forwards 0.2s;
    }
    .slide-active .slide-title {
        animation: fadeInUp 0.8s ease forwards 0.4s;
    }
    .slide-active .slide-description {
        animation: fadeInUp 0.8s ease forwards 0.6s;
    }
    .slide-active .slide-button {
        animation: fadeInUp 0.8s ease forwards 0.8s;
    }
    .slide-active .slide-img-container {
        animation: rotateIn 1.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards 0.5s;
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @keyframes rotateIn {
        from { opacity: 0; transform: rotate(45deg) scale(0.8); }
        to { opacity: 1; transform: rotate(0) scale(1); }
    }
</style>

<script>
    import Swiper from 'swiper';
    import { Navigation, Pagination, Autoplay, EffectFade } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/navigation';
    import 'swiper/css/pagination';
    import 'swiper/css/effect-fade';

    const swiper = new Swiper('.hero-swiper', {
        modules: [Navigation, Pagination, Autoplay, EffectFade],
        loop: true,
        effect: 'fade',
        fadeEffect: {
            crossFade: true
        },
        autoplay: {
            delay: 5000,
            disableOnInteraction: false,
        },
        navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
        },
        pagination: {
            el: '.swiper-pagination',
            clickable: true,
        },
        on: {
            init: function () {
                this.slides[this.activeIndex].classList.add('slide-active');
            },
            slideChangeTransitionStart: function () {
                this.slides.forEach(slide => slide.classList.remove('slide-active'));
                this.slides[this.activeIndex].classList.add('slide-active');
            }
        }
    });
</script>
