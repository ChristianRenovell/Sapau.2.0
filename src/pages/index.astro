---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import BrandsGrid from "../components/BrandsGrid.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import brands from "../data/brands.json";
import { getLangFromUrl, useTranslations, withBase } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const en = lang === "en";

const facts = [
    { title: t("info.dist"), desc: t("info.distDesc"), icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" },
    { title: t("info.garantia"), desc: t("info.garantiaDesc"), icon: "M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z M9 12l2 2 4-4" },
    { title: t("info.soporte"), desc: t("info.soporteDesc"), icon: "M12 3a9 9 0 100 18 9 9 0 000-18z M12 7v5l3 3" },
];

const areas = [
    {
        title: en ? "Pools" : "Piscinas",
        desc: en
            ? "Above-ground pools, pool cleaners, filtration, water treatment, covers, accessories and heating."
            : "Piscinas desmontables, limpiafondos, filtración, tratamiento de agua, cubiertas, accesorios y calefacción.",
        img: "/assets/img/slide/gre.webp",
        alt: en ? "Wooden above-ground pool in a garden" : "Piscina elevada de madera en un jardín",
    },
    {
        title: en ? "Garden" : "Jardín",
        desc: en ? "Chairs, sun loungers, outdoor and beach." : "Sillas, tumbonas, exterior y playa.",
        img: "/assets/img/crespo-jardin.webp",
        alt: en ? "Reclining lounger by a pool" : "Tumbona reclinable junto a una piscina",
    },
    {
        title: en ? "Leisure" : "Tiempo libre",
        desc: en ? "Barbecues, coolers, tents and kayaks." : "Barbacoas, neveras, tiendas y kayaks.",
        img: "/assets/img/BBK.png",
        alt: en ? "Barbecue and leisure equipment" : "Barbacoa y equipamiento de tiempo libre",
    },
];

const aboutItems = [
    { title: t("about.item1"), desc: t("about.item1Desc") },
    { title: t("about.item2"), desc: t("about.item2Desc") },
    { title: t("about.item3"), desc: t("about.item3Desc") },
];

const arrowUpRight = "M7 17L17 7M8 7h9v9";
---

<Layout
  title={en
    ? "Comercial Sapau SL | Prestige Distribution in Canary Islands"
    : "Comercial Sapau SL | Distribución de Prestigio en Canarias"}
>
  <Header variant="overlay" />

  <main id="contenido" tabindex="-1" class="focus:outline-none">
    <HeroCarousel />

    <!-- Facts strip -->
    <section class="border-b border-line bg-white">
      <div class="mx-auto grid max-w-7xl grid-cols-[repeat(auto-fit,minmax(220px,1fr))] px-5 md:px-8">
        <div class="flex items-center gap-4 py-7 pr-6">
          <div class="font-display text-[44px] font-extrabold tracking-tight text-ocean">{brands.length}</div>
          <div class="text-[15px] leading-snug font-semibold">
            {t("facts.brands")}<br /><span class="font-normal text-muted">{t("facts.brandsDesc")}</span>
          </div>
        </div>
        {
          facts.map((fact) => (
            <div class="flex items-center gap-4 py-7 pr-6">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-ocean" aria-hidden="true">
                <path d={fact.icon} />
              </svg>
              <div class="text-[15px] leading-snug font-semibold">
                {fact.title}<br /><span class="font-normal text-muted">{fact.desc}</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Areas -->
    <section id="areas" class="mx-auto max-w-7xl px-5 pt-24 md:px-8 md:pt-32">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
        <div class="flex max-w-2xl flex-col gap-4">
          <div class="eyebrow">{t("sections.areasEyebrow")}</div>
          <h2 class="text-[clamp(36px,4.4vw,60px)] leading-none font-bold">{t("sections.areas")}</h2>
        </div>
        <p class="max-w-sm text-[17px] leading-relaxed text-muted">{t("sections.areasDesc")}</p>
      </div>

      <div class="flex flex-wrap gap-5">
        <a
          href="#marcas"
          data-area-link="piscinas"
          class="group relative flex min-h-[460px] flex-[7_1_480px] overflow-hidden rounded-[28px] bg-ink text-white md:min-h-[600px]"
        >
          <img src={withBase(areas[0].img)} alt={areas[0].alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 motion-safe:group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-b from-ink/0 from-40% to-ink/85"></div>
          <div class="relative mt-auto flex w-full flex-wrap items-end justify-between gap-5 p-7 md:p-9">
            <div class="flex max-w-md flex-col gap-2.5">
              <div class="text-[13px] font-semibold tracking-[0.16em] text-white/75">01</div>
              <h3 class="text-[44px] leading-none font-bold">{areas[0].title}</h3>
              <p class="leading-relaxed text-white/90">{areas[0].desc}</p>
            </div>
            <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-lime text-ink">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrowUpRight} /></svg>
            </span>
          </div>
        </a>

        <div class="flex flex-[5_1_340px] flex-col gap-5">
          {
            areas.slice(1).map((area, i) => (
              <a
                href="#marcas"
                data-area-link={i === 0 ? "jardin" : "tiempo-libre"}
                class="group relative flex min-h-[290px] flex-1 overflow-hidden rounded-[28px] bg-ink text-white"
              >
                <img src={withBase(area.img)} alt={area.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-1000 motion-safe:group-hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-b from-ink/0 from-30% to-ink/85"></div>
                <div class="relative mt-auto flex w-full items-end justify-between gap-4 p-7">
                  <div class="flex flex-col gap-2">
                    <div class="text-[13px] font-semibold tracking-[0.16em] text-white/75">0{i + 2}</div>
                    <h3 class="text-[34px] leading-none font-bold">{area.title}</h3>
                    <p class="text-[15px] leading-normal text-white/90">{area.desc}</p>
                  </div>
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-ink transition-colors group-hover:bg-lime">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrowUpRight} /></svg>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <BrandsGrid />

    <!-- About -->
    <section id="nosotros" class="bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-16 px-5 py-24 md:px-8 md:py-32">
        <div class="relative aspect-square flex-[1_1_440px] overflow-hidden rounded-[28px] bg-line">
          <img
            src={withBase("/assets/img/slide/Slide3.webp")}
            alt={en ? "Two people on the beach with Coleman chairs and cooler" : "Dos personas en la playa con sillas y nevera Coleman"}
            loading="lazy"
            class="h-full w-full object-cover"
          />
          <div class="absolute bottom-5 left-5 flex items-center gap-3 rounded-2xl bg-white px-4 py-3.5 text-sm font-semibold">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ocean" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            Igueste de Candelaria, Tenerife
          </div>
        </div>
        <div class="flex flex-[1_1_440px] flex-col gap-7">
          <div class="eyebrow">{t("about.eyebrow")}</div>
          <h2 class="text-[clamp(34px,4vw,52px)] leading-[1.02] font-bold">{t("about.title")}</h2>
          <p class="text-lg leading-relaxed text-muted">{t("about.desc")}</p>
          <ol class="flex flex-col border-t border-line">
            {
              aboutItems.map((item, i) => (
                <li class="flex items-baseline gap-5 border-b border-line py-5">
                  <span class="min-w-7 font-display text-[15px] font-bold text-ocean">{String(i + 1).padStart(2, "0")}</span>
                  <div class="flex flex-col gap-1">
                    <span class="text-[17px] font-semibold">{item.title}</span>
                    <span class="text-[15px] text-muted">{item.desc}</span>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <ContactSection />
  </main>

  <Footer />
</Layout>
