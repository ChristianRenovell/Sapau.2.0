---
import "../styles/global.css";
import { getLangFromUrl, withBase } from "../i18n/utils";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Comercial Sapau SL - Distribución en el Archipiélago Canario",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href={withBase("/assets/img/logos/logo.png")} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-ground font-sans text-ink antialiased">
		<slot />
	</body>
</html>

